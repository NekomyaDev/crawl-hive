# Оплата спавна: не задано — симуляция; sol — фаза 1 (до запуска токена); token — фаза 2 (сжигание токена проекта)
PAYMENT_TOKEN=sol
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Режим sol: куда уходит SOL. Не задано — казна проекта (BUYBACK_TREASURY в src/lib/economy.ts).
# Для чистого сжигания: SPAWN_SOL_RECIPIENT=1nc1nerator11111111111111111111111111111111
# SPAWN_SOL_RECIPIENT=DgCogtUuki6MZzypK1dKHYWfHLMUnKkNUBQwo6rWTGUJ

# Режим sol: свои цены по тирам larva,worker,soldier,queen (по умолчанию 0.05,0.2,0.75,2.5)
# SPAWN_PRICE_SOL=0.001,0.002,0.003,0.005

# Режим token
# TOKEN_MINT=<адрес минта токена проекта>
# TOKEN_SYMBOL=<тикер>
# TOKEN_DECIMALS=6

# Только devnet: секрет кошелька-фосета (JSON-массив байт), раздаёт тестовые SOL или токены проекта
# DEVNET_FAUCET_SECRET=[12,34,...]

# Живые краулеры
# XAI_API_KEY=xai-...            # X-краулеры (Grok x_search) и ИИ-разбор Telegram/страниц
# XAI_MODEL=grok-4.7
# XAI_DAILY_CALLS=300            # потолок вызовов Grok в сутки
# X_MIN_INTERVAL_MIN=30          # X-краулер не чаще раза в N минут
# CRAWL_DISABLED=1               # выключить планировщик

# Сервер
# SESSION_SECRET=<случайная строка>   # иначе генерируется и хранится в .data/
# DATA_DIR=/data                       # где хранить состояние (по умолчанию ./.data)
