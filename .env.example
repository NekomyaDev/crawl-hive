# Spawn payment: unset = simulated; sol = phase 1 (before the project token); token = phase 2 (project token burn)
PAYMENT_TOKEN=sol
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# sol mode: where SOL goes. Unset = the project treasury (BUYBACK_TREASURY in src/lib/economy.ts).
# For a pure burn: SPAWN_SOL_RECIPIENT=1nc1nerator11111111111111111111111111111111
# SPAWN_SOL_RECIPIENT=DgCogtUuki6MZzypK1dKHYWfHLMUnKkNUBQwo6rWTGUJ

# sol mode: per-tier prices larva,worker,soldier,queen (default 0.05,0.2,0.75,2.5)
# SPAWN_PRICE_SOL=0.001,0.002,0.003,0.005
# Robinhood Chain: EVM wallets (MetaMask, Rabby) pay in ETH to this address; empty keeps ETH payments off
# SPAWN_ETH_RECIPIENT=0x...
# SPAWN_PRICE_ETH=0.002,0.008,0.03,0.1     # optional per-tier prices (larva..queen)
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Project token $CRAWLHIVE. TOKEN_MINT also drives the token block on the home page (chart, price, contract,
# buyback & burn stats, owner buyback button) independently of PAYMENT_TOKEN: spawns stay in SOL until PAYMENT_TOKEN=token.
# Unset = the home page shows "$CRAWLHIVE is launching". Buybacks need SOLANA_CLUSTER=mainnet-beta.
# TOKEN_MINT=<project token mint address>
# TOKEN_SYMBOL=CRAWLHIVE         # ticker without $, default CRAWLHIVE (token-mode spawns fall back to TOKEN if unset)
# TOKEN_DECIMALS=6               # token-mode spawns only; buybacks read decimals from the mint

# Crawler of the day: 50% of the day's creator fees go to the owner of the best crawler
# REWARD_MIN_HOLD=1              # $CRAWLHIVE the winner's wallet must hold
# CREATOR_WALLET=<pump.fun creator wallet>   # may pay rewards besides the treasury wallet

# devnet only: faucet wallet secret (JSON byte array), hands out test SOL or tokens
# DEVNET_FAUCET_SECRET=[12,34,...]

# Live crawlers
# XAI_API_KEY=xai-...            # X crawlers (Grok x_search) and AI reading of Telegram / pages
# XAI_MODEL=grok-4.20-0309-non-reasoning
# XAI_DAILY_CALLS=60             # max Grok calls per day

# Jev (TypeSafe decision model) via OpenRouter: triages crawler finds and decides Grok Bot takes.
# Optional: without the key crawlers work exactly as before. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# JEV_MODEL=typesafe/jev-1.13
# JEV_DAILY_CALLS=3000           # max Jev decisions per day
# JEV_DROP=0.15                  # finds Jev rates below this are skipped as noise
# JEV_SURE=0.7                   # Grok Bot takes Jev is this sure of skip Grok
# SCAN_X_DAILY=20                # X checks in free Instant Crawl scans per day (0 turns them off)
# X_MIN_INTERVAL_MIN=0           # extra floor for X runs; tiers already limit them to 120/60/30/15 min
# CRAWL_DISABLED=1               # turn the scheduler off

# Paid term and network
# CRAWLER_TERM_DAYS=30           # days of crawling bought by a spawn or a renewal
# DEMO_NETWORK=0                 # hide the simulated demo network (production)

# Telegram delivery of signals (create a bot with @BotFather)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# PUBLIC_URL=https://crawlhive.xyz   # used in links inside Telegram messages

# Server
# SESSION_SECRET=<random string>      # otherwise generated and stored in the data dir
# DATA_DIR=/data                       # where state is kept (default ./.data)

# Per-IP rate limit (src/proxy.ts): average requests per second and burst size; RATE_LIMIT_OFF=1 disables it.
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=60
