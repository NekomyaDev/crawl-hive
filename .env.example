# Оплата спавна: не задано — симуляция; sol — фаза 1 (до запуска токена); crawl — фаза 2 (сжигание $CRAWL)
PAYMENT_TOKEN=sol
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Режим sol: куда уходит SOL. Не задано — казна проекта (BUYBACK_TREASURY в src/lib/economy.ts).
# Для чистого сжигания: SPAWN_SOL_RECIPIENT=1nc1nerator11111111111111111111111111111111
# SPAWN_SOL_RECIPIENT=DgCogtUuki6MZzypK1dKHYWfHLMUnKkNUBQwo6rWTGUJ

# Режим sol: свои цены по тирам larva,worker,soldier,queen (по умолчанию 0.05,0.2,0.75,2.5)
# SPAWN_PRICE_SOL=0.001,0.002,0.003,0.005

# Режим crawl
# CRAWL_MINT=<адрес минта $CRAWL>
# CRAWL_DECIMALS=6

# Только devnet: секрет кошелька-фосета (JSON-массив байт), раздаёт тестовые SOL/$CRAWL
# DEVNET_FAUCET_SECRET=[12,34,...]
